# ============================================
# Market Maule - Environment Variables
# Copia este archivo a .env y ajusta los valores
# ============================================

# Servidor
NODE_ENV=production
PORT=3000

# Base de datos MySQL (contenedor local)
DATABASE_URL=mysql://marketmaule:marketmaule_password@db:3306/marketmaule

# Base de datos alternativa: TiDB Cloud
# DATABASE_URL=mysql://user:password@host.tidbcloud.com:4000/marketmaule?sslaccept=strict

# Autenticación
JWT_SECRET=tu-jwt-secret-key-muy-seguro-cambia-esto
SESSION_SECRET=tu-session-secret-key-muy-seguro-cambia-esto

# OAuth (opcional - para auth real)
# OAUTH_CLIENT_ID=tu-client-id
# OAUTH_CLIENT_SECRET=tu-client-secret
# OAUTH_REDIRECT_URL=https://marketmaule.tudominio.cl/api/auth/callback

# Email (opcional)
# SMTP_HOST=smtp.tudominio.cl
# SMTP_PORT=587
# SMTP_USER=noreply@tudominio.cl
# SMTP_PASS=tu-password
